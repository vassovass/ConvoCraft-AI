# ConvoCraft AI example environment variables
GEMINI_API_KEY=your_gemini_api_key_here # obtain this from your Google AI (Gemini) dashboard
# PORT=3001

# Optional: enables the ElevenLabs (Scribe) speech-to-text provider
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here # from https://elevenlabs.io/app/settings/api-keys
# ELEVENLABS_STT_MODEL=scribe_v1 # or scribe_v2 